# Server Port
PORT=5090

# Client Application URL (Frontend URL, e.g. Netlify/Vercel URL)
CLIENT_URL=https://lulutrelo.netlify.app

# Public URL of this backend; linked from board invitation emails
BASE_URL=https://lulutrello-2.onrender.com

# Secret used to sign the JWTs handed to the SPA
JWT_SECRET=

# Firebase / Firestore credentials. Either the service account JSON minified
# onto a single line, or FIREBASE_PROJECT_ID alone when the host already
# provides Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_PROJECT_ID=

# GitHub OAuth app. All three are mandatory - the server refuses to boot
# without them. The callback URL points back at THIS backend, not at CLIENT_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://lulutrello-2.onrender.com/auth/callback

# Preferred transport in production: Brevo delivers over HTTPS, so it works on
# hosts that block the SMTP ports. Render blocks 25/465/587 on free web
# services, which makes the SMTP settings below unusable there.
# When this is set it wins and SMTP is ignored entirely.
BREVO_API_KEY=

# SMTP, used when BREVO_API_KEY is empty - suitable for local development.
# Gmail requires a 16-character App Password here, not the account password.
# With neither transport configured the server logs verification codes and the
# API still answers 200, so a misconfigured deployment looks healthy while no
# mail ever arrives.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Also used as the Brevo sender, which must be a verified sender in Brevo.
SMTP_FROM="LuluTrelloApp" <you@gmail.com>
