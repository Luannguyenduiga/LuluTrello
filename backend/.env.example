# Server Port
PORT=5090

# Client Application URL (Frontend URL, e.g. Netlify/Vercel URL)
CLIENT_URL=https://lulutrelo.netlify.app

# Public URL of this backend; linked from board invitation emails
BASE_URL=https://lulutrello-2.onrender.com

# Secret used to sign the JWTs handed to the SPA
JWT_SECRET=

# Firebase / Firestore credentials. Either the service account JSON minified
# onto a single line, or FIREBASE_PROJECT_ID alone when the host already
# provides Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_PROJECT_ID=

# GitHub OAuth app. All three are mandatory - the server refuses to boot
# without them. The callback URL points back at THIS backend, not at CLIENT_URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://lulutrello-2.onrender.com/auth/callback

# Preferred transport in production: Brevo delivers over HTTPS, so it works on
# hosts that block the SMTP ports. Render blocks 25/465/587 on free web
# services, which makes the SMTP settings below unusable there.
# When this is set it wins and SMTP is ignored entirely.
BREVO_API_KEY=

# SMTP, used when BREVO_API_KEY is empty - suitable for local development.
# Gmail requires a 16-character App Password here, not the account password.
# With neither transport configured the server logs verification codes instead
# of sending them. That is the local development path; with NODE_ENV=production
# /auth/send-code fails with 503 rather than reporting a send that never left.
# Check what the server actually has with: pnpm --filter backend mail:check
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Also used as the Brevo sender, which must be a verified sender in Brevo.
SMTP_FROM="LuluTrelloApp" <you@gmail.com>

# ---- Zalo assistant -------------------------------------------------------
# Bot token from the Zalo Bot manager, in the form <bot_id>:<secret>. Without it
# board activity and the progress report are only written to the server log.
ZALO_TOKEN=
# The group the bot posts into. Add the bot to the group, have somebody send a
# message there, then read message.chat.id from GET /zalo/updates.
ZALO_CHAT_ID=
# Shared secret required by every /zalo/* route (x-zalo-secret header). With
# this empty those routes stay closed.
ZALO_ADMIN_SECRET=
# Progress report schedule, in this timezone. Defaults: 20:00 Asia/Ho_Chi_Minh.
ZALO_REPORT_TIME=20:00
ZALO_TIMEZONE=Asia/Ho_Chi_Minh
# Activity is collected for this many milliseconds and sent as one message;
# 0 sends every change immediately.
ZALO_BATCH_MS=15000
# Optional: only report these board ids (comma separated), and how many boards
# are listed in full before the rest become a single summary line.
ZALO_REPORT_BOARDS=
ZALO_REPORT_MAX_BOARDS=10
# The bot also answers questions asked in the group when it is tagged. Set this
# to false to keep the notifications but stop the bot from replying.
ZALO_REPLY_ENABLED=true
# Questions about the boards are answered from Firestore for free. Anything else
# goes to Gemini, if a key is set - without one the bot lists what it does
# understand instead. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Defaults to gemini-3.6-flash. gemini-2.5-flash is refused for new API keys.
GEMINI_MODEL=gemini-3.6-flash

# ---- Admin console -------------------------------------------------------
# Comma separated list of emails allowed into /admin. Matched against the email
# the account signed in with, lower-cased. Empty means nobody is an admin and
# the console stays closed - it never falls open.
ADMIN_EMAILS=
